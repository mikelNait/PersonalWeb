---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { projects } from "../data/projects";
import { jobs } from "../data/jobs";

// Cada subcarpeta de src/assets/miniatures/ es un tema y se muestra como un carrusel.
//   src/assets/miniatures/01-space-marines/01-captain.jpg
//   src/assets/miniatures/01-space-marines/02-librarian.jpg
//   src/assets/miniatures/02-necrons/01-overlord.jpg
// Los nombres de carpeta y archivo se convierten en texto: "01-space-marines" -> "Space Marines"
// (el número inicial solo sirve para ordenar y no se muestra)
const photoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/miniatures/*/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true }
);

const toTitle = (name: string) =>
  name
    .replace(/\.[^.]+$/, "")
    .replace(/^\d+[-_ ]*/, "")
    .replace(/[-_]+/g, " ")
    .replace(/(^|\s)\S/g, (c) => c.toUpperCase());

const themesByFolder = new Map<string, { image: ImageMetadata; caption: string }[]>();
for (const [path, mod] of Object.entries(photoFiles).sort(([a], [b]) => a.localeCompare(b))) {
  const [folder, fileName] = path.split("/").slice(-2);
  if (!themesByFolder.has(folder)) themesByFolder.set(folder, []);
  themesByFolder.get(folder)!.push({ image: mod.default, caption: toTitle(fileName) });
}

const themes = [...themesByFolder].map(([folder, photos]) => ({
  title: toTitle(folder),
  photos,
}));
---

<BaseLayout title="Portfolio | Mikel">
  <section class="min-h-screen bg-[#f5f0e6] px-5 py-8 sm:px-8 md:px-12 xl:px-16">
    <div class="mx-auto max-w-[1380px]">
      <!-- Título -->
      <div class="mb-16 text-center">
        <div class="mx-auto mb-6 h-[3px] w-full max-w-[320px] bg-[#caa334]"></div>
        <h1 class="font-serif text-4xl tracking-[0.12em] text-[#8c6b1f] sm:text-6xl lg:text-7xl">
          OPERA
        </h1>
        <div class="mx-auto mt-6 h-[3px] w-full max-w-[320px] bg-[#caa334]"></div>
      </div>

      <!-- Empleo -->
      <section>
        <div class="text-center">
          <h2 class="font-serif text-3xl uppercase tracking-[0.05em] text-[#a67d24] sm:text-5xl">
            Cursus Honorum
          </h2>
          <p class="mt-4 text-lg text-[#8e8371]">
            My professional career
          </p>
        </div>

        <ol class="relative mx-auto mt-12 max-w-[900px] border-l-2 border-[#d5b02f] pl-8 sm:pl-12">
          {jobs.map((job) => (
            <li class="relative mb-10 last:mb-0">
              <!-- Punto de la línea de tiempo -->
              <span
                class:list={[
                  "absolute top-8 -left-[41px] h-4 w-4 rounded-full border-[3px] border-[#98731d] sm:-left-[57px]",
                  job.end ? "bg-[#f5f0e6]" : "bg-[#d7b33e] ring-4 ring-[#d7b33e]/30",
                ]}
              ></span>

              <article class="rounded-[12px] border-[3px] border-[#d5b02f] bg-[#f7f2e8] p-5 sm:p-8 shadow-[0_18px_40px_rgba(70,50,13,0.10)]">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
                  <h3 class="font-serif text-2xl uppercase tracking-[0.04em] text-[#a67d24]">
                    {job.role}
                  </h3>
                  <span class="font-serif text-sm tracking-[0.15em] text-[#8e8371]">
                    {job.start} – {job.end ?? "Present"}
                  </span>
                </div>

                <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
                  <p class="text-lg text-[#8c6b1f]">{job.company}</p>
                  {!job.end && (
                    <span class="rounded-full bg-[#d7b33e] px-3 py-0.5 text-xs uppercase tracking-[0.15em] text-[#4c3508]">
                      Current
                    </span>
                  )}
                </div>

                <div class="mt-4 h-px bg-[#d9c299]/70"></div>

                <p class="mt-5 text-lg leading-8 text-[#6f6558]">
                  {job.description}
                </p>

                {job.tech && (
                  <div class="mt-6 flex flex-wrap gap-2">
                    {job.tech.map((tech) => (
                      <span class="rounded-full border border-[#cfb15f] bg-[#f5e6c8] px-3 py-1 text-sm text-[#7a5a14]">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </article>
            </li>
          ))}
        </ol>
      </section>

      <!-- Separador -->
      <div class="my-20 flex items-center gap-5 text-[#d0b266]">
        <div class="h-px flex-1 bg-[#d9c299]/70"></div>
        <span class="text-base">✦</span>
        <div class="h-px flex-1 bg-[#d9c299]/70"></div>
      </div>

      <!-- Proyectos -->
      <section>
        <div class="text-center">
          <h2 class="font-serif text-3xl uppercase tracking-[0.05em] text-[#a67d24] sm:text-5xl">
            Opera Laboris
          </h2>
          <p class="mt-4 text-lg text-[#8e8371]">
            Projects I have developed
          </p>
        </div>

        <div class="mt-12 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
          {projects.map((project) => (
            <article class="flex flex-col rounded-[12px] border-[3px] border-[#d5b02f] bg-[#f7f2e8] p-5 sm:p-8 shadow-[0_18px_40px_rgba(70,50,13,0.10)]">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-serif text-2xl uppercase tracking-[0.04em] text-[#a67d24]">
                  {project.name}
                </h3>
                {project.year && (
                  <span class="font-serif text-sm tracking-[0.15em] text-[#8e8371]">
                    {project.year}
                  </span>
                )}
              </div>

              <div class="mt-4 h-px bg-[#d9c299]/70"></div>

              <p class="mt-5 flex-1 text-lg leading-8 text-[#6f6558]">
                {project.description}
              </p>

              <div class="mt-6 flex flex-wrap items-center gap-2">
                {project.tech.map((tech) => (
                  <span class="rounded-full border border-[#cfb15f] bg-[#f5e6c8] px-3 py-1 text-sm text-[#7a5a14]">
                    {tech}
                  </span>
                ))}
                <span class="ml-auto text-xs uppercase tracking-[0.15em] text-[#a99d88]">
                  Proprietary code
                </span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Separador -->
      <div class="my-20 flex items-center gap-5 text-[#d0b266]">
        <div class="h-px flex-1 bg-[#d9c299]/70"></div>
        <span class="text-base">✦</span>
        <div class="h-px flex-1 bg-[#d9c299]/70"></div>
      </div>

      <!-- Galería de miniaturas -->
      <section>
        <div class="text-center">
          <h2 class="font-serif text-3xl uppercase tracking-[0.05em] text-[#a67d24] sm:text-5xl">
            Miniaturae
          </h2>
          <p class="mt-4 text-lg text-[#8e8371]">
            Warhammer miniatures I have painted
          </p>
        </div>

        {themes.length > 0 ? (
          <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {themes.map((theme) => (
              <figure class="group" data-carousel>
                <div class="relative rounded-[10px] border-[4px] border-[#d5b02f] bg-[#f7f2e8] p-2 shadow-[0_18px_40px_rgba(70,50,13,0.12)] transition duration-300 group-hover:-translate-y-1">
                  <div
                    data-track
                    class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto scroll-smooth rounded-[6px]"
                  >
                    {theme.photos.map((photo) => (
                      <a
                        href={photo.image.src}
                        target="_blank"
                        rel="noopener"
                        class="w-full shrink-0 snap-center"
                      >
                        <Image
                          src={photo.image}
                          alt={`${theme.title} – ${photo.caption}`}
                          widths={[400, 800]}
                          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                          class="aspect-square w-full object-cover"
                        />
                      </a>
                    ))}
                  </div>

                  {theme.photos.length > 1 && (
                    <>
                      <button
                        type="button"
                        data-prev
                        aria-label="Previous photo"
                        class="absolute top-1/2 left-4 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[#d5b02f] bg-[#f7f2e8]/90 text-xl text-[#8c6b1f] shadow transition hover:bg-[#f5e6c8]"
                      >
                        ‹
                      </button>
                      <button
                        type="button"
                        data-next
                        aria-label="Next photo"
                        class="absolute top-1/2 right-4 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border-2 border-[#d5b02f] bg-[#f7f2e8]/90 text-xl text-[#8c6b1f] shadow transition hover:bg-[#f5e6c8]"
                      >
                        ›
                      </button>
                      <div class="absolute bottom-5 left-1/2 flex -translate-x-1/2 gap-2">
                        {theme.photos.map((_, i) => (
                          <button
                            type="button"
                            data-dot
                            aria-label={`Photo ${i + 1}`}
                            class:list={[
                              "h-2.5 w-2.5 rounded-full border border-[#8c6b1f] transition",
                              i === 0 ? "bg-[#d7b33e]" : "bg-[#f7f2e8]/80",
                            ]}
                          ></button>
                        ))}
                      </div>
                    </>
                  )}
                </div>
                <figcaption class="mt-4 text-center font-serif text-xl uppercase tracking-[0.04em] text-[#a67d24]">
                  {theme.title}
                </figcaption>
              </figure>
            ))}
          </div>
        ) : (
          <div class="mx-auto mt-12 max-w-[640px] rounded-[12px] border-[3px] border-dashed border-[#d5b02f] bg-[#f7f2e8] p-10 text-center">
            <p class="font-serif text-2xl uppercase tracking-[0.04em] text-[#a67d24]">
              In aedificatione
            </p>
            <p class="mt-4 text-lg text-[#6f6558]">
              Painted miniatures coming soon...
            </p>
          </div>
        )}
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Carruseles de miniaturas: flechas, puntos y sincronización al deslizar con el dedo
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-track]")!;
    const dots = [...carousel.querySelectorAll<HTMLElement>("[data-dot]")];
    const count = track.children.length;
    if (count < 2) return;

    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const goTo = (i: number) => {
      const index = (i + count) % count;
      track.scrollTo({ left: index * track.clientWidth });
    };

    carousel.querySelector("[data-prev]")?.addEventListener("click", () => goTo(current() - 1));
    carousel.querySelector("[data-next]")?.addEventListener("click", () => goTo(current() + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

    track.addEventListener("scroll", () => {
      const active = current();
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-[#d7b33e]", i === active);
        dot.classList.toggle("bg-[#f7f2e8]/80", i !== active);
      });
    });
  });
</script>
